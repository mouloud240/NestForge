#----------------------------------------------------------------
# Example .env file for application configuration
# Values are set so the app boots locally without editing anything.
# Replace placeholders with your real credentials before production.
# IT Supports expanding variables using ${VAR_NAME} syntax
#----------------------------------------------------------------
# Created by: Mouloud Hasrane
# License: MIT
#----------------------------------------------------------------

# ------------------------
# Core App Config
# ------------------------
AUTHOR=Mouloud Hasrane        # Application author/maintainer
BACKEND_URL=http://localhost:3000  # Base URL of the backend server
BACKEND_API_URL=${BACKEND_URL}/api/v1  # API base URL
FRONTEND_URL=http://localhost:5173  # Base URL of the frontend

# ------------------------
# App Environment
# ------------------------
NODE_ENV=development          # Environment (development, production, test)
PORT=3000                     # Port on which the backend runs
APP_URL=http://localhost:3000 # Public URL used in logs and callbacks

# ------------------------
# Database Config
# ------------------------
DB_HOST=localhost             # Database host
DB_PORT=5432                  # Database port
DB_USERNAME=postgres          # Database username
DB_PASSWORD=postgres          # Database password
DB_NAME=nestforge             # Database name

POSTGRES_USER=postgres        # PostgreSQL root user
POSTGRES_PASSWORD=postgres    # PostgreSQL root password
POSTGRES_DB=nestforge          # Default PostgreSQL database

# ------------------------
# Redis Config
# ------------------------
REDIS_HOST=localhost          # Redis host
REDIS_PORT=6379               # Redis port

# ------------------------
# Email Service Config
# ------------------------
MAIL_TRANSPORT=file            # file (dev, writes .eml to MAIL_DIRECTORY), smtp, or resend
MAIL_FROM=NestForge <no-reply@localhost>  # Default sender address
MAIL_DIRECTORY=var/mail       # Where the file transport writes .eml files
SMTP_URL=                     # e.g. smtp://user:password@smtp.example.com:587 (when MAIL_TRANSPORT=smtp)
RESEND_API_KEY=               # Resend API key (when MAIL_TRANSPORT=resend)

# ------------------------
# Authentication Config
# ------------------------

# Google OAuth (leave empty to disable)
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id          # Google OAuth client ID
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret    # Google OAuth client secret
GOOGLE_OAUTH_CALLBACK_URL=${BACKEND_API_URL}/authentication/oauth/google/callback

# ------------------------
# CSRF Config
# ------------------------
CSRF_SECRET=defaultCsrfSecret  # Secret key for signing CSRF tokens (change in production)
CSRF_COOKIE_SECURE=false       # Set to true in production (HTTPS only)

# ------------------------
# Session Config
# ------------------------
SESSION_SECRET=defaultSessionSecret  # Secret key for signing session cookies (change in production)
SESSION_COOKIE_SECURE=false    # Set to true in production (HTTPS only)
SESSION_COOKIE_SAMESITE=lax    # lax, strict, or none
SESSION_COOKIE_MAX_AGE=86400000  # Session cookie max age in milliseconds

# ------------------------
# Rate Limiting
# ------------------------
THROTTLER_LIMIT=100           # Max requests per TTL window
THROTTLER_TTL=60              # TTL window in seconds
THROTTLER_BLOCK_DURATION=10   # Block duration in seconds

# ------------------------
# Clustering
# ------------------------
NUM_CPUS=1                    # Number of worker processes when cluster mode is enabled
CLUSTERIZE_APP=false          # Set to true to enable Node.js cluster mode

# ------------------------
# Logging
# ------------------------
LOG_LEVEL=info                # Log level (debug, verbose, info, warn, error)
