---
import '../styles/landing.css';

const nav = [
	{ href: '/docs/introduction/', label: 'Introduction' },
	{ href: '/docs/quickstart/', label: 'Quickstart' },
];

const metrics = [
	{ value: 'v1.7.0', label: 'current release' },
	{ value: 'REST + GraphQL', label: 'Express + HTTP' },
	{ value: 'MIT', label: 'open source' },
];
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>nestforge — NestJS, scaffolded</title>
		<meta
			name="description"
			content="Scaffold a production-ready NestJS backend from the command line. Express, Redis-backed sessions, and no-op persistence so it boots before you write a line."
		/>
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/logo.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
		/>
	</head>
	<body>
		<main class="hero">
			<div class="grain" aria-hidden="true"></div>

			<nav class="nav" aria-label="Main">
				<a class="brand" href="/">
					<img class="nav-logo" src="/logo.svg" alt="" aria-hidden="true" />
					<span>nestforge</span>
				</a>
				<div class="links">
					{
						nav.map((item) => (
							<a href={item.href}>{item.label}</a>
						))
					}
				</div>
				<a
					class="github"
					href="https://github.com/mouloud240/NestForge"
					aria-label="GitHub repository"
				>
					<svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true">
						<path
							d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
							fill="currentColor"
						/>
					</svg>
				</a>
			</nav>

			<section class="stage">
				<img class="hero-logo" src="/logo.svg" alt="NestForge logo" width="260" />
				<p class="kicker">A command-line NestJS starter</p>
				<h1 class="title">NestJS, scaffolded<span class="dot">.</span></h1>
				<p class="lede">
					One command gives you a production-grade NestJS backend — Express,
					Redis-backed sessions, and no-op persistence so it boots before
					you&rsquo;ve written a line.
				</p>
				<pre class="install" data-copy="npx create-nestforge@latest" aria-label="Install command">
					<code><span class="prompt">$</span> npx create-nestforge@latest</code>
					<button class="copy-btn" type="button" aria-label="Copy install command">
						<svg class="copy-icon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
							<path fill="currentColor" d="M4 1.5a.5.5 0 0 1 .5-.5h6a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-6a.5.5 0 0 1-.5-.5v-1Zm0 3a.5.5 0 0 1 .5-.5h6a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-6a.5.5 0 0 1-.5-.5v-1Zm-2.5 3a.5.5 0 0 0-.5.5v7a.5.5 0 0 0 .5.5h10a.5.5 0 0 0 .5-.5v-7a.5.5 0 0 0-.5-.5h-10Z"/>
						</svg>
						<svg class="check-icon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" hidden>
							<path fill="currentColor" d="M12.736 3.97a.733.733 0 0 1 1.047 0c.286.289.29.756.01 1.05L7.88 12.01a.733.733 0 0 1-1.065.02L3.217 8.384a.757.757 0 0 1 0-1.06.733.733 0 0 1 1.047 0l3.052 3.093 5.4-6.425a.247.247 0 0 1 .02-.022Z"/>
						</svg>
						<span class="copy-label">Copy</span>
					</button>
				</pre>
				<div class="cta">
					<a class="btn btn-primary" href="/docs/quickstart/">Get started</a>
					<a class="btn btn-secondary" href="/docs/introduction/">Read the docs</a>
				</div>
			</section>

			<section class="metrics" aria-label="Project facts">
				{
					metrics.map((metric) => (
						<div class="metric">
							<span class="value">{metric.value}</span>
							<span class="label">{metric.label}</span>
						</div>
					))
				}
			</section>
		</main>

		<script>
			(function () {
				const COPY_FEEDBACK_MS = 1500;
				function copyText(element) {
					const text = element.getAttribute('data-copy');
					if (!text || !navigator.clipboard) return;
					navigator.clipboard.writeText(text).then(() => {
						const button = element.querySelector('.copy-btn');
						if (!button) return;
						const icon = button.querySelector('.copy-icon');
						const check = button.querySelector('.check-icon');
						const label = button.querySelector('.copy-label');
						if (icon) icon.setAttribute('hidden', '');
						if (check) check.removeAttribute('hidden');
						if (label) label.textContent = 'Copied';
						setTimeout(() => {
							if (icon) icon.removeAttribute('hidden');
							if (check) check.setAttribute('hidden', '');
							if (label) label.textContent = 'Copy';
						}, COPY_FEEDBACK_MS);
					});
				}
				document.querySelectorAll('[data-copy]').forEach((el) => {
					el.addEventListener('click', () => copyText(el));
					const btn = el.querySelector('.copy-btn');
					if (btn) btn.addEventListener('click', (e) => { e.stopPropagation(); copyText(el); });
				});
			})();
		</script>
	</body>
</html>
