{
  "name": "create-nestforge",
  "version": "2.0.0",
  "description": "Interactive CLI to scaffold a NestJS starter project.",
  "author": "Mouloud Hasrane <mouloudhasrane24@gmail.com>",
  "license": "MIT",
  "type": "module",
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "create-nestforge": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "LICENSE"
  ],
  "keywords": [
    "nestjs",
    "starter",
    "scaffold",
    "boilerplate",
    "graphql",
    "rest",
    "cli",
    "create-nestforge"
  ],
  "homepage": "https://github.com/mouloud240/NestForge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mouloud240/NestForge.git"
  },
  "bugs": {
    "url": "https://github.com/mouloud240/NestForge/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "copy-templates": "node copy-templates.mjs",
    "build": "pnpm copy-templates && tsup src/index.ts --format esm --clean --dts",
    "dev": "pnpm copy-templates && tsup src/index.ts --format esm --watch",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.0",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0",
    "@vitest/coverage-v8": "^3.0.0"
  }
}
